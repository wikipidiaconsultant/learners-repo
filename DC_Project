def convert_to_usd_apply(revenue_str):
    
    revenue_str = str(revenue_str) 
    
    currency_rates = {'$': 1, '£': 1.25, '€': 1.10, "₹":0.012}  

    
    match = re.search(r'([\£€₹])?(\d+([.,]\d+)?)', revenue_str)
    if match:
        currency = match.group(1) or '$' 
        amount = match.group(2).replace(',', '')

        if currency in currency_rates:
            converted_amount = amount * currency_rates[currency]
            return converted_amount
        else:
            return revenue_str  
    else:
        return revenue_str


df['Revenue'] = df['Revenue'].apply(convert_to_usd_apply)
df['MinRevenue'] = df['MinRevenue'].apply(convert_to_usd_apply)
df['MaxRevenue'] = df['MaxRevenue'].apply(convert_to_usd_apply)

